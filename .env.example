# انسخ هذا الملف باسم .env واملأ القيم الحقيقية.
# لا ترفع ملف .env على GitHub أبدًا (مستثنى في .gitignore).

# إيميل Gmail الذي سيُرسل منه
GMAIL_USER=your.address@gmail.com

# كلمة مرور التطبيق (16 حرفًا) من https://myaccount.google.com/apppasswords
# ليست كلمة مرور Gmail العادية.
GMAIL_APP_PASSWORD=abcdefghijklmnop

# الإيميل المستقبِل. يمكن وضع أكثر من عنوان مفصولة بفاصلة.
MAIL_TO=your.address@gmail.com

# مفتاح OpenAI من https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# اختياريان، لكنهما يرفعان حدود الطلبات ويحسّنان استقرار الجلب الأسبوعي.
GITHUB_TOKEN=
HF_TOKEN=

# Developer Token من Product Hunt API Dashboard.
PRODUCT_HUNT_TOKEN=
